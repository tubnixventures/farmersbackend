# GEMINI_API_KEY: Required for Cloudflare AI emulation / Gemini semantic search
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# MongoDB Connection String (Atlas or local replica set)
# If empty, built-in in-memory ACID database engine will be used automatically for seamless dev
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/farmersworld?retryWrites=true&w=majority"
MONGODB_DB_NAME="farmersworld"

# Security & Dual Password JWT Secrets
JWT_SECRET="super-secure-jwt-secret-farmersworld-kenya-2026-production"
COOKIE_DOMAIN=""
NODE_ENV="development"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="cf_account_id_example"
R2_ACCESS_KEY_ID="r2_access_key_id_example"
R2_SECRET_ACCESS_KEY="r2_secret_key_example"
R2_BUCKET_NAME="farmersworld-media"
R2_PUBLIC_DOMAIN="media.farmersworld.co.ke"

# Paystack (M-Pesa / Card Collections)
PAYSTACK_SECRET_KEY="sk_test_paystack_secret_key_kenya"
PAYSTACK_PUBLIC_KEY="pk_test_paystack_public_key_kenya"

# PawaPay (African Mobile Money Collections & Dynamic Payout Pricing)
PAWAPAY_API_KEY="pawapay_live_or_sandbox_token"
PAWAPAY_BASE_URL="https://api.sandbox.pawapay.cloud"

# ZeptoMail (Transactional Email for OTPs, Payout Alerts & Invoices)
ZEPTOMAIL_TOKEN="zoho_zeptomail_token_kenya"
ZEPTOMAIL_SENDER="support@farmersworld.co.ke"

# Infobip WhatsApp & SMS (Buyer, Farmer, Agrovet, Admin alerts)
INFOBIP_BASE_URL="https://api.infobip.com"
INFOBIP_API_KEY="infobip_api_key_example"
INFOBIP_WHATSAPP_NUMBER="+254700000000"
INFOBIP_SMS_SENDER="FARMERSWLD"

# Cloudflare Analytics Engine & Scheduler
CF_ANALYTICS_DATASET="marketplace_events"
CRON_SECRET="farmersworld-secure-disbursement-cron-key"

